# Copy to .env and fill in (never commit .env).
# Push to Supabase Edge Functions: make set-edge-secrets

SUPABASE_URL=https://klvzgfheneyqrwfxtfyg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SEED_USER_ID=

# ── Which API powers Explore search ─────────────────────────────────────────
# edamam | bigoven | spoonacular | edamam+bigoven | all
RECIPE_SEARCH_PROVIDER=edamam

# Edamam
EDAMAM_APP_ID=
EDAMAM_APP_KEY=

# BigOven
BIGOVEN_API_KEY=
BIGOVEN_USER_EMAIL=
BIGOVEN_USER_PASSWORD=

# Spoonacular (optional — for provider=spoonacular or all)
SPOONACULAR_API_KEY=

# AI recipe generation
ANTHROPIC_API_KEY=

# Welcome email sequence (Resend + Auth hook) — Edge Function secrets only
RESEND_API_KEY=
SEND_EMAIL_HOOK_SECRET=
EMAIL_CRON_SECRET=
# Optional overrides (defaults: quillo://scan, quillo://premium)
# QUILLO_SCAN_DEEP_LINK=quillo://scan
# QUILLO_PREMIUM_DEEP_LINK=quillo://premium
# RESEND_FROM=Quillo <hello@quilloai.co.uk>

# Recipe images — Gemini 3 Pro Image (Nano Banana Pro), preferred over Spoonacular
GEMINI_API_KEY=
# Optional override (default: gemini-2.5-flash-image — stable, ~10–20s per image)
# Do NOT use gemini-3-pro-image here (2–3 min per image).
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Max AI images generated per Explore search (default 5)
GEMINI_IMAGE_MAX_PER_SEARCH=5

# Flutter --dart-define keys (do not hardcode in app source)
# SENTRY_DSN=
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# ONESIGNAL_APP_ID=
